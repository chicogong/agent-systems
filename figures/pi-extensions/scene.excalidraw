      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Skill 提供按需指令；Extension 在进程内接入代码能力。Pi Package 可同时分发两者。",
      "fontSize": 19,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Skill 提供按需指令；Extension 在进程内接入代码能力。Pi Package 可同时分发两者。",
      "autoResize": false,
      "lineHeight": 1.25
    },
